FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libvulkan1 mesa-vulkan-drivers ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY llama.cpp/build-vulkan/bin /opt/llama/bin

ENV LD_LIBRARY_PATH=/opt/llama/bin

EXPOSE 8080

ENTRYPOINT ["/opt/llama/bin/llama-server"]
