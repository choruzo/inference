# Busqueda web. Copia este fichero a .env y no lo subas al repositorio.
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_FALLBACK=tavily
WEB_SEARCH_MIN_RESULTS=3
WEB_SEARCH_LIMIT=5
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-a-random-secret
TAVILY_API_KEY=
WEB_TIMEOUT=15
WEB_MAX_BYTES=2000000
WEB_MAX_REDIRECTS=5
WEB_FETCH_RESULTS=3
WEB_FETCH_MAX_CHARS=20000
